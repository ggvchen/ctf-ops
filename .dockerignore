# 构建上下文瘦身 + 不要把比赛现场数据打进镜像
.venv/
.git/
.gitignore

# 现场产物（含 flag、靶机 IP、提交 token、备份包）
evidence/
backups/
report/
outbox/
logs/
dist/

# 真实配置：镜像里用 *.example.yaml 现生成
config/config.yaml
config/targets.yaml

# 构建产物 / 缓存
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
ctfops/ctfops/

# 编辑器与系统垃圾
.DS_Store
.idea/
.vscode/
*.swp
